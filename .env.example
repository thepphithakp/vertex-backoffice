# คัดลอกเป็น .env.local แล้วใส่ค่าจริง — .env.local ไม่ถูก commit (ดู .gitignore)
# ใช้เฉพาะตอน npm run dev เท่านั้น ตอน deploy จริงแอปเรียก /api/v1 บน host เดียวกัน
# จึงไม่ต้องมี proxy

# IP หรือ URL ของ ingress ที่จะ proxy /api ไปให้
DEV_API_TARGET=http://10.0.0.1

# host header ที่ ingress ใช้ route — ไม่ส่งค่านี้จะไม่เจอ rule ของ vertex
DEV_API_HOST=example.com
